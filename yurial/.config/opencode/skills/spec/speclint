#!/bin/sh
# speclint — mechanical checks over specs authored with the spec skill.
#
# Usage: speclint <path>...
#   path: a spec .md file, an index.md, a GLOSSARY.md, or a directory
#         (a directory lints every index.md found inside first — collecting
#         reference IDs — then every GLOSSARY.md, then every other .md file
#         recursively).
#
# Spec file checks:
#   - requirement lines match "- R<digits>(.<digits>)*[.] Text";
#   - a leaf line ends with '.', a group line ends with ':';
#   - an ID with children is a group, an ID without children is a leaf;
#   - requirement IDs are unique; every child's ancestor IDs exist and
#     are groups;
#   - every Examples entry A<x> mirrors an existing requirement R<x>;
#   - verification lines match "- V<digits>(.<digits>)*[.] Text" and
#     verification IDs are unique;
#   - tests lines match "- T<digits>(.<digits>)*[.] Text", test IDs are
#     unique, every leaf Tests entry cites a requirement R-ID, and
#     every R-ID cited by a Tests entry (ID-range endpoints included,
#     e.g. R3-R7) names an existing requirement;
#   - justification lines match "- J<digits>(.<digits>)*[.] Text" and
#     justification IDs are unique;
#   - a prefixed entry (R, A, V, T, J) must not continue onto an indented
#     next line: one entry occupies exactly one line;
#   - prefixed entries form a flat list: a line that is itself indented
#     prefixed entry (matching leading whitespace + "- R2.1." style)
#     is an error - hierarchy is expressed by multi-level IDs only,
#     never by markdown nesting. An indented child still counts as a
#     child for the group/leaf consistency checks, but is registered
#     nowhere else: fix the indentation and re-run to surface any
#     structural findings (duplicate IDs, ancestors) on the newly
#     visible entry;
#   - a requirement line citing a literal value — any numeric
#     literal, with units (30 s, 5 ms, 100%) or bare (3, 0,5) — is
#     an error: literals are forbidden in requirement lines; cite the
#     name the spec keys the value under in Interface/Configuration
#     instead (config key, argument name, fixed-value identifier, or
#     the spec-chosen semantic name of a magic number). Exempt
#     (documented in SKILL.md section 5): code literals inside
#     backticks (`30s`); ID and level tokens whose digit directly
#     follows a letter or digit (R1.2, A3, L1, v1.2, TLS1.2, UTF-8);
#     a number glued to a preceding ALL-CAPS word (TLS 1.2); and the
#     trailing digit of a cited dotted ID followed by its word
#     (R1.3 minutes, R2.2 states) — an identifier segment, not a
#     value. The check runs on every requirement line regardless of
#     which sections the file has.
# index.md checks:
#   - row paths exist; Status is draft or stable; Reference is a lowercase
#     hyphen-separated unique ID.
# GLOSSARY.md checks:
#   - term IDs are lowercase <reference>/<term>; alphabetical order;
#     Defined in equals the term prefix (optionally with requirement IDs);
#     the prefix resolves against the collected index references.
#
# Findings go to stderr; warnings carry a "warning:" prefix. Exit status:
# 0 — clean, 1 — warnings but no errors, 2 — lint errors; a usage error
# (invalid invocation) counts as an error: also 2.
# Known limit: only an indented continuation of a prefixed entry is
# detected; a non-indented (lazy markdown) continuation is invisible to a
# line-based lint, and the one-line rule stays partly a review check.

set -u

# fail aggregates per-unit exit codes as their maximum: 2 (errors) beats
# 1 (warnings only) beats 0 (clean).
fail=0

[ $# -ge 1 ] || { printf 'usage: speclint <path>...\n' >&2; exit 2; }

refsrc=$(mktemp "${TMPDIR:-/tmp}/speclint.refs.XXXXXX") || exit 2
filelist=$(mktemp "${TMPDIR:-/tmp}/speclint.list.XXXXXX") || exit 2
trap 'rm -f "$refsrc" "$filelist"' EXIT INT TERM

lint_spec() {
    awk '
        function err(nr, m) {
            printf "%s:%d: %s\n", FILENAME, nr, m > "/dev/stderr"
            bad = 1
        }
        function warn(nr, m) {
            printf "%s:%d: warning: %s\n", FILENAME, nr, m > "/dev/stderr"
            warned = 1
        }
        # One-line rule: a prefixed entry (R/A/V/T/J) must not continue onto
        # an indented next line. Flat-list rule: a line that is itself an
        # indented prefixed entry violates the flat list - hierarchy is
        # expressed by multi-level IDs only. This block runs first for every
        # line and clears pend; the entry blocks below then set pend for the
        # next line to check - on every path, including their early-error
        # paths (malformed ID punctuation, duplicate ID), so a wrapped
        # continuation is always attributed to the line that started it.
        # The flat-list branch clears pend explicitly: an indented child
        # entry already carries the flat-list error and must not also be
        # reported as a wrap of its parent.
        {
            if ($0 ~ /^[ \t]+- [RAVTJ][0-9]/) {
                cid = $0
                sub(/^[ \t]+- /, "", cid)
                fam = substr(cid, 1, 1)
                sub(/^[RAVTJ]/, "", cid)
                sub(/[^0-9.].*$/, "", cid)
                sub(/\.$/, "", cid)
                err(NR, "prefixed entries must be a flat list - indented child entry \"" fam cid "\" found; express hierarchy via multi-level IDs")
                # only R-family children take part in the R group/leaf
                # structure; seen keys are "." + numeric ID (no letter).
                if (fam == "R")
                    indented["." cid] = 1
                pend = ""
                next
            }
            if (pend != "" && $0 ~ /^[ \t]+/)
                err(pendnr, "entry " pend " is wrapped onto the next line - one entry occupies exactly one line, wrapping is forbidden")
            pend = ""
        }
        /^- R[0-9]+(\.[0-9]+)*[ .:]/ {
            id = $0; sub(/^- R/, "", id); sub(/[^0-9.].*$/, "", id); sub(/\.$/, "", id)
            tail = $0; sub(/^- R[0-9]+(\.[0-9]+)*/, "", tail)
            # pend is set before the early-error paths (malformed ID
            # punctuation, duplicate ID) so that a wrapped continuation
            # of an already-erroring line is still diagnosed as its wrap.
            pend = "R" id; pendnr = NR
            if (substr(tail, 1, 1) != ".") {
                err(NR, "requirement ID must be followed by a period and a space")
                next
            }
            key = "." id
            if (key in seen) {
                err(NR, "duplicate requirement ID R" id)
                next
            }
            seen[key] = substr($0, length($0), 1)
            ln[key] = NR
            # Literal-value scan: any numeric literal - with units or
            # bare - inside the padded tail (padding replaces ^|$
            # boundaries; unit alternatives longest-first, mawk picks
            # the first matching alternative). Unconditional,
            # error-level: literals are forbidden in requirement lines
            # whatever sections the file has. Code literals in
            # backticks are stripped before the scan; a match is
            # post-filtered when it is an identifier segment, not a
            # value: its digit follows the dot of a dotted ID-like
            # token (R1.3 minutes -> the "3" belongs to R1.3), or the
            # number is glued to a preceding ALL-CAPS word (TLS 1.2).
            tgt = " " tail " "
            gsub(/`[^`]*`/, " ", tgt)
            restl = tgt
            while (match(restl, /[^A-Za-z0-9][0-9]+([.,][0-9]+)?([ \t]?(seconds|second|secs|sec|us|ns|ms|s|minutes|minute|mins|min|hours|hour|hrs|hr|h|days|day|bytes|Bytes|byte|Byte|KiB|MiB|GiB|TiB|kB|KB|MB|GB|TB|B|мкс|мс|сек|мин|%))?[^A-Za-z0-9]/)) {
                pre = substr(restl, 1, RSTART - 1)
                c = substr(restl, RSTART, 1)
                if (!((c == "." && pre ~ /[A-Za-z]?[0-9.]+$/) || pre ~ /[A-Z][A-Z]+[ \t]*$/)) {
                    err(NR, "requirement R" id " cites a literal value (" substr(restl, RSTART + 1, RLENGTH - 2) ") - forbidden, cite the name the spec keys the value under in Interface/Configuration")
                    break
                }
                restl = substr(restl, RSTART + RLENGTH - 1)
            }
        }
        /^- A[0-9]+(\.[0-9]+)*\./ {
            aid = $0; sub(/^- A/, "", aid); sub(/[^0-9.].*$/, "", aid); sub(/\.$/, "", aid)
            pend = "A" aid; pendnr = NR
            if (!("." aid in seen))
                err(NR, "Examples entry A" aid " mirrors no requirement R" aid)
        }
        /^- V[0-9]+(\.[0-9]+)*[ .:]/ {
            vid = $0; sub(/^- V/, "", vid); sub(/[^0-9.].*$/, "", vid); sub(/\.$/, "", vid)
            vtail = $0; sub(/^- V[0-9]+(\.[0-9]+)*/, "", vtail)
            pend = "V" vid; pendnr = NR
            if (substr(vtail, 1, 1) != ".") {
                err(NR, "verification ID must be followed by a period and a space")
                next
            }
            if (vid in vseen) {
                err(NR, "duplicate verification ID V" vid)
                next
            }
            vseen[vid] = 1
        }
        /^- T[0-9]+(\.[0-9]+)*[ .:]/ {
            tid = $0; sub(/^- T/, "", tid); sub(/[^0-9.].*$/, "", tid); sub(/\.$/, "", tid)
            ttail = $0; sub(/^- T[0-9]+(\.[0-9]+)*/, "", ttail)
            pend = "T" tid; pendnr = NR
            if (substr(ttail, 1, 1) != ".") {
                err(NR, "test ID must be followed by a period and a space")
                next
            }
            if (tid in tseen) {
                err(NR, "duplicate test ID T" tid)
                next
            }
            tseen[tid] = 1
            if (ttail !~ /R[0-9]/ && substr($0, length($0), 1) != ":")
                err(NR, "Tests entry T" tid " cites no requirement R-ID")
            # Citation existence: every R-ID cited on a Tests entry
            # line (ID-range endpoints included, e.g. R3-R7) must name
            # a requirement seen in this file. V and J citations are
            # not checked.
            cre = $0
            while (match(cre, /R[0-9]+(\.[0-9]+)*/)) {
                ctok = substr(cre, RSTART, RLENGTH)
                if (!(("." substr(ctok, 2)) in seen))
                    err(NR, "test T" tid " cites nonexistent requirement " ctok)
                cre = substr(cre, RSTART + RLENGTH)
            }
        }
        /^- J[0-9]+(\.[0-9]+)*[ .:]/ {
            jid = $0; sub(/^- J/, "", jid); sub(/[^0-9.].*$/, "", jid); sub(/\.$/, "", jid)
            jtail = $0; sub(/^- J[0-9]+(\.[0-9]+)*/, "", jtail)
            pend = "J" jid; pendnr = NR
            if (substr(jtail, 1, 1) != ".") {
                err(NR, "justification ID must be followed by a period and a space")
                next
            }
            if (jid in jseen) {
                err(NR, "duplicate justification ID J" jid)
                next
            }
            jseen[jid] = 1
        }
        END {
            for (k in seen) {
                haschild = 0
                for (j in seen)
                    if (j != k && index(j, k ".") == 1) { haschild = 1; break }
                # an indented child (flat-list violation) still counts as
                # a child: the flat-list error already flags it, the
                # group/leaf consistency must not pile a second,
                # misleading finding on top.
                if (!haschild)
                    for (j in indented)
                        if (index(j, k ".") == 1) { haschild = 1; break }
                if (seen[k] == ":" && !haschild)
                    err(ln[k], "group ID R" substr(k, 2) " has no children")
                if (seen[k] == "." && haschild)
                    err(ln[k], "leaf ID R" substr(k, 2) " has children - a group line ends with a colon")
                if (seen[k] != "." && seen[k] != ":")
                    err(ln[k], "requirement line R" substr(k, 2) " must end with . (leaf) or : (group)")
                p = k
                while (sub(/\.[0-9]+$/, "", p) > 0 && p != "") {
                    if (!(p in seen)) {
                        err(ln[k], "ancestor ID R" substr(p, 2) " of R" substr(k, 2) " is missing")
                        break
                    }
                    if (seen[p] == ".")
                        err(ln[p], "ancestor ID R" substr(p, 2) " of R" substr(k, 2) " is a leaf, must be a group (:)")
                }
            }
            exit bad ? 2 : (warned ? 1 : 0)
        }
    ' "$1"
    rc=$?
    if [ "$rc" -gt "$fail" ]; then fail=$rc; fi
}

lint_index() {
    idxdir=$(dirname "$1")
    root=$(git -C "$idxdir" rev-parse --show-toplevel 2>/dev/null) || root=
    if [ -z "$root" ]; then
        if [ "$(basename "$idxdir")" = "specs" ]; then
            root=$(dirname "$idxdir")
        else
            root="$idxdir"
        fi
    fi
    awk -v idxdir="$idxdir" -v root="$root" '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        function err(nr, m) {
            printf "%s:%d: %s\n", FILENAME, nr, m > "/dev/stderr"
            bad = 1
        }
        /^\|/ {
            if ($0 ~ /^\|[ \t]*-+/) next
            n = split($0, f, "|")
            if (n < 5) next
            for (i = 2; i <= 4; i++) f[i] = trim(f[i])
            path = f[2]; ref = f[3]; st = f[4]
            if (path == "Path" || path == "") next
            if (system("test -e \"" root "/" path "\"") != 0 && system("test -e \"" idxdir "/" path "\"") != 0)
                err(NR, "index row path does not exist (tried " root "/" path " and " idxdir "/" path "): " path)
            if (st != "draft" && st != "stable")
                err(NR, "Status must be draft or stable, got: " st)
            if (ref !~ /^[a-z0-9]+(-[a-z0-9]+)*$/)
                err(NR, "Reference must be a lowercase hyphen-separated ID: " ref)
            else if (ref in refs)
                err(NR, "duplicate Reference: " ref)
            refs[ref] = 1
            print ref
        }
        END { exit bad ? 2 : 0 }
    ' "$1" >> "$refsrc"
    rc=$?
    if [ "$rc" -gt "$fail" ]; then fail=$rc; fi
}

lint_glossary() {
    if [ -s "$refsrc" ]; then
        checkrefs=1
    else
        checkrefs=0
        printf 'speclint: %s: no index references collected (lint an index.md first); prefix resolution skipped\n' "$1" >&2
    fi
    awk -v REFFILE="$refsrc" -v CHECKREFS="$checkrefs" '
        function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        function err(nr, m) {
            printf "%s:%d: %s\n", FILENAME, nr, m > "/dev/stderr"
            bad = 1
        }
        BEGIN {
            while ((getline l < REFFILE) > 0) { sub(/\n$/, "", l); refs[l] = 1 }
            close(REFFILE)
            prev = ""
        }
        /^\|/ {
            if ($0 ~ /^\|[ \t]*-+/) next
            n = split($0, f, "|")
            if (n < 4) next
            for (i = 2; i <= 4; i++) f[i] = trim(f[i])
            term = f[2]; def = f[3]; where = f[4]
            if (term == "Term" || term == "") next
            if (term !~ /^[a-z0-9-]+\/[a-z0-9-]+$/) {
                err(NR, "term ID must be lowercase <reference>/<term>: " term)
                next
            }
            if (prev != "" && term < prev)
                err(NR, "glossary not alphabetical: " term " after " prev)
            prev = term
            split(term, pp, "/")
            if (where != pp[1] && where !~ ("^" pp[1] " \\([A-Za-z0-9., -]+\\)$"))
                err(NR, "Defined in must equal the term prefix " pp[1] " (optionally with requirement IDs), got: " where)
            if (CHECKREFS == 1 && !(pp[1] in refs))
                err(NR, "term prefix " pp[1] " resolves to no index reference")
        }
        END { exit bad ? 2 : 0 }
    ' "$1"
    rc=$?
    if [ "$rc" -gt "$fail" ]; then fail=$rc; fi
}

for arg in "$@"; do
    if [ -d "$arg" ]; then
        find "$arg" -name index.md -type f | LC_ALL=C sort > "$filelist"
        while IFS= read -r f; do lint_index "$f"; done < "$filelist"
        find "$arg" -name GLOSSARY.md -type f | LC_ALL=C sort > "$filelist"
        while IFS= read -r f; do lint_glossary "$f"; done < "$filelist"
        find "$arg" -name '*.md' ! -name index.md ! -name GLOSSARY.md -type f | LC_ALL=C sort > "$filelist"
        while IFS= read -r f; do lint_spec "$f"; done < "$filelist"
    elif [ -f "$arg" ]; then
        case $(basename "$arg") in
            index.md)
                lint_index "$arg"
                ;;
            GLOSSARY.md)
                d=$(dirname "$arg")
                if [ ! -s "$refsrc" ] && [ -f "$d/index.md" ]; then
                    lint_index "$d/index.md"
                fi
                lint_glossary "$arg"
                ;;
            *.md)
                lint_spec "$arg"
                ;;
            *)
                printf 'speclint: %s: not a .md file\n' "$arg" >&2
                fail=2
                ;;
        esac
    else
        printf 'speclint: %s: no such file or directory\n' "$arg" >&2
        fail=2
    fi
done

exit "$fail"
