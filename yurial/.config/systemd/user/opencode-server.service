[Unit]
Description=OpenCode headless server (opencode serve)
Documentation=https://opencode.ai/docs/server/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SSH_AUTH_SOCK=%h/.ssh/agent.sock
ExecStart=/bin/sh -c '. "$HOME/.secret" && exec "$HOME/.opencode/bin/opencode" serve --port 4096 --hostname 127.0.0.1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
