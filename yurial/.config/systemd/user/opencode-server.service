[Unit]
Description=OpenCode headless server (opencode serve)
Documentation=https://opencode.ai/docs/server/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.opencode/bin/opencode serve --port 4096 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
